[sub_resource type="Shader" id="Shader_5qies"]
code = "shader_type spatial;
render_mode unshaded, depth_draw_opaque;

uniform sampler2D albedo_texture:hint_default_white;


void fragment() {
	ALBEDO = texture(albedo_texture, UV).rgb;
}
"

